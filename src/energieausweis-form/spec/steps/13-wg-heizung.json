{
  "id": "wg_heizung",
  "title": "WG: Heizungsanlage",
  "meta": "A4",
  "singleColumn": true,
  "when": { "eq": ["gebaeudetyp", "WG"] },
  "intro": { "title": "Heizung", "text": "Angaben zur Heizungsanlage." },
  "blocks": [
    {
      "title": "Wärmeerzeuger",
      "fields": [
        { "key": "heizung_waermeerzeuger", "label": "Energieträger", "type": "select", "required": true, "optionsRef": "heizung_waermeerzeuger", "tipKey": "heizung_waermeerzeuger" },
        { "key": "heizung_heizsystem", "label": "Heizsystem", "type": "radio", "required": true, "optionsRef": "heizung_heizsystem" },
        { "key": "heizung_baujahr", "label": "Baujahr der Heizungsanlage", "type": "number", "required": false, "min": 1800, "max": 2100, "hint": "z. B. 2010" },
        { "key": "heizung_nennleistung", "label": "Nennleistung (kW)", "type": "number", "required": false, "min": 1, "max": 9999, "hint": "z. B. 20" }
      ]
    },
    {
      "title": "Kesseltyp",
      "fields": [
        {
          "key": "heizung_kesseltyp",
          "label": "Kesseltyp",
          "type": "imgselect",
          "when": { "neq": ["ausweisart", "Verbrauchsausweis"] },
          "required": { "neq": ["ausweisart", "Verbrauchsausweis"] },
          "options": [
            { "value": "Konstanttemperatur", "label": "Konstanttemperatur", "img": "../assets/images/heizung/konstanttemperaturkessel.png", "tipKey": "heizung_konstanttemperatur" },
            { "value": "Niedertemperatur", "label": "Niedertemperatur", "img": "../assets/images/heizung/niedertemperaturkessel.png", "tipKey": "heizung_niedertemperatur" },
            { "value": "Brennwert", "label": "Brennwert", "img": "../assets/images/heizung/brennwertkessel.png", "tipKey": "heizung_brennwert" },
            { "value": "Wärmepumpe", "label": "Wärmepumpe", "img": "../assets/images/heizung/waermepumpe.png", "tipKey": "heizung_waermepumpe" }
          ]
        }
      ]
    },
    {
      "title": "Wärmeabgabe",
      "fields": [
        { "key": "heizung_waermeabgabe", "label": "Wärmeabgabe", "type": "select", "when": { "neq": ["ausweisart", "Verbrauchsausweis"] }, "required": { "neq": ["ausweisart", "Verbrauchsausweis"] }, "optionsRef": "heizung_waermeabgabe" },
        { "key": "heizung_waermeverteilung", "label": "Art der Wärmeverteilung", "type": "radio", "when": { "neq": ["ausweisart", "Verbrauchsausweis"] }, "required": { "neq": ["ausweisart", "Verbrauchsausweis"] }, "optionsRef": "heizung_waermeverteilung" }
      ]
    },
    {
      "title": "Zusatz",
      "fields": [
        { "key": "pv_dach", "label": "Photovoltaik (PV) auf dem Dach", "type": "checkbox", "required": false, "when": { "neq": ["ausweisart", "Verbrauchsausweis"] }, "infoText": "Anlage auf dem Dach, die Sonnenlicht in Strom umwandelt. Der Strom kann im Haus genutzt oder ins Netz eingespeist werden.", "full": true },
        { "key": "hz_solar", "label": "Solarthermie für Heizung vorhanden", "type": "radio", "required": false, "when": { "neq": ["ausweisart", "Verbrauchsausweis"] }, "optionsRef": "ja_nein_radio", "tipKey": "heizung_hz_solar" },
        { "key": "zirkulation", "label": "Zirkulation (Warmwasser)", "type": "checkbox", "required": false, "when": { "neq": ["ausweisart", "Verbrauchsausweis"] }, "infoText": "Kreislauf von Heizungs- oder Warmwasser in den Leitungen, damit Wärme bzw. warmes Wasser schnell und gleichmäßig im Gebäude verfügbar ist.", "full": true },
        { "key": "heizungsrohre_gedaemmt", "label": "Heizungsrohre gedämmt", "type": "radio", "required": false, "when": { "neq": ["ausweisart", "Verbrauchsausweis"] }, "optionsRef": "ja_nein_radio", "tipKey": "heizung_rohre_gedaemmt" }
      ]
    },
    {
      "title": "Verbrauchsdaten (für Verbrauchsausweis)",
      "fields": [
        {
          "type": "checklist",
          "full": true,
          "when": { "eq": ["ausweisart", "Verbrauchsausweis"] },
          "title": "Hauptenergieträger",
          "text": "Nutzen Sie die Einheit direkt aus der Abrechnung (z. B. kWh, m3, l)."
        },
        {
          "key": "etr_traeger_gewechselt",
          "label": "Wurde der Energieträger in den letzten 3 Jahren gewechselt?",
          "type": "radio",
          "full": true,
          "when": { "eq": ["ausweisart", "Verbrauchsausweis"] },
          "required": { "eq": ["ausweisart", "Verbrauchsausweis"] },
          "optionsRef": "ja_nein_radio"
        },
        {
          "key": "etr_traeger_von",
          "label": "Früherer Energieträger",
          "type": "text",
          "full": true,
          "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr_traeger_gewechselt", "Ja"] }] },
          "hint": "z. B. Heizöl"
        },
        {
          "key": "etr_traeger_zu",
          "label": "Neuer Energieträger",
          "type": "text",
          "full": true,
          "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr_traeger_gewechselt", "Ja"] }] },
          "hint": "z. B. Wärmepumpe"
        },
        {
          "key": "etr_abrechnungsart",
          "label": "Abrechnungsart",
          "type": "radio",
          "full": true,
          "when": { "eq": ["ausweisart", "Verbrauchsausweis"] },
          "required": { "eq": ["ausweisart", "Verbrauchsausweis"] },
          "optionsRef": "etr_abrechnungsart"
        },
        {
          "key": "etr_verbrauch_betrifft",
          "label": "Verbrauch betrifft",
          "type": "radio",
          "full": true,
          "when": { "eq": ["ausweisart", "Verbrauchsausweis"] },
          "required": { "eq": ["ausweisart", "Verbrauchsausweis"] },
          "optionsRef": "etr_verbrauch_betrifft_wg"
        },
        {
          "key": "etr1_kategorie",
          "label": "Energieträger",
          "type": "select",
          "full": true,
          "when": { "eq": ["ausweisart", "Verbrauchsausweis"] },
          "required": { "eq": ["ausweisart", "Verbrauchsausweis"] },
          "optionsRef": "etr_kategorie_bk",
          "tipKey": "etr_kategorie"
        },
        {
          "key": "etr1_heizung",
          "label": "Fuer Heizung genutzt?",
          "type": "radio",
          "full": true,
          "when": { "eq": ["ausweisart", "Verbrauchsausweis"] },
          "required": { "eq": ["ausweisart", "Verbrauchsausweis"] },
          "optionsRef": "ja_nein_radio"
        },
        {
          "key": "etr1_tww",
          "label": "Fuer Warmwasser genutzt?",
          "type": "radio",
          "full": true,
          "when": { "eq": ["ausweisart", "Verbrauchsausweis"] },
          "required": { "eq": ["ausweisart", "Verbrauchsausweis"] },
          "optionsRef": "ja_nein_radio"
        },
        {
          "key": "etr1_periods",
          "label": "Abrechnungszeiträume",
          "type": "periods3",
          "full": true,
          "when": { "eq": ["ausweisart", "Verbrauchsausweis"] },
          "required": { "eq": ["ausweisart", "Verbrauchsausweis"] },
          "startKey": "etr1_start",
          "unitKey": "etr1_einheit",
          "defaultUnit": "kWh",
          "startMonthsBack": 36,
          "unitOptions": [
            { "value": "kWh", "label": "kWh" },
            { "value": "m3", "label": "m3" },
            { "value": "l", "label": "l" }
          ],
          "tipKey": "etr_perioden",
          "fields": []
        },
        {
          "key": "etr1_is_fw",
          "label": "Fernwärme?",
          "type": "radio",
          "full": true,
          "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
          "required": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
          "optionsRef": "ja_nein_radio",
          "tipKey": "etr_fw_flags"
        },
        {
          "key": "etr1_gebaeude_nah",
          "label": "Gebäudenah erzeugt?",
          "type": "radio",
          "full": true,
          "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
          "required": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
          "optionsRef": "ja_nein_radio",
          "tipKey": "etr_fw_flags"
        },
        {
          "key": "etr1_primfaktor",
          "label": "Primaerenergiefaktor",
          "type": "number",
          "full": true,
          "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
          "required": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
          "min": 0,
          "max": 10,
          "tipKey": "etr_primfaktor"
        },
        {
          "key": "etr1_anteil_erneuerbar",
          "label": "Anteil erneuerbar (%)",
          "type": "number",
          "full": true,
          "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
          "required": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
          "min": 0,
          "max": 100,
          "tipKey": "etr_anteile"
        },
        {
          "key": "etr1_anteil_kwk",
          "label": "Anteil KWK (%)",
          "type": "number",
          "full": true,
          "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
          "required": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
          "min": 0,
          "max": 100,
          "tipKey": "etr_anteile"
        },
        {
          "type": "checklist",
          "full": true,
          "when": { "eq": ["ausweisart", "Verbrauchsausweis"] },
          "title": "Optional: zweiter Energieträger",
          "text": "Nur hinzufügen, wenn ein zusätzlicher Energieträger tatsächlich im Verbrauch vorkommt."
        },
        {
          "key": "etr2_enabled",
          "label": "Zweiten Energieträger erfassen",
          "type": "checkbox",
          "full": true,
          "when": { "eq": ["ausweisart", "Verbrauchsausweis"] },
          "tipKey": "etr2_optional"
        },
        {
          "key": "etr2_kategorie",
          "label": "Energieträger 2",
          "type": "select",
          "full": true,
          "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr2_enabled", true] }] },
          "required": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr2_enabled", true] }] },
          "optionsRef": "etr_kategorie_bk",
          "tipKey": "etr_kategorie"
        },
        {
          "key": "etr2_heizung",
          "label": "Fuer Heizung genutzt?",
          "type": "radio",
          "full": true,
          "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr2_enabled", true] }] },
          "required": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr2_enabled", true] }] },
          "optionsRef": "ja_nein_radio"
        },
        {
          "key": "etr2_tww",
          "label": "Fuer Warmwasser genutzt?",
          "type": "radio",
          "full": true,
          "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr2_enabled", true] }] },
          "required": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr2_enabled", true] }] },
          "optionsRef": "ja_nein_radio"
        },
        {
          "key": "etr2_periods",
          "label": "Abrechnungszeiträume (Energieträger 2)",
          "type": "periods3",
          "full": true,
          "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr2_enabled", true] }] },
          "required": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr2_enabled", true] }] },
          "startKey": "etr2_start",
          "unitKey": "etr2_einheit",
          "defaultUnit": "kWh",
          "startMonthsBack": 36,
          "unitOptions": [
            { "value": "kWh", "label": "kWh" },
            { "value": "m3", "label": "m3" },
            { "value": "l", "label": "l" }
          ],
          "tipKey": "etr_perioden",
          "fields": []
        },
        {
          "key": "etr2_is_fw",
          "label": "Fernwärme?",
          "type": "radio",
          "full": true,
          "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
          "required": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
          "optionsRef": "ja_nein_radio",
          "tipKey": "etr_fw_flags"
        },
        {
          "key": "etr2_gebaeude_nah",
          "label": "Gebäudenah erzeugt?",
          "type": "radio",
          "full": true,
          "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
          "required": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
          "optionsRef": "ja_nein_radio",
          "tipKey": "etr_fw_flags"
        },
        {
          "key": "etr2_primfaktor",
          "label": "Primaerenergiefaktor",
          "type": "number",
          "full": true,
          "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
          "required": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
          "min": 0,
          "max": 10,
          "tipKey": "etr_primfaktor"
        },
        {
          "key": "etr2_anteil_erneuerbar",
          "label": "Anteil erneuerbar (%)",
          "type": "number",
          "full": true,
          "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
          "required": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
          "min": 0,
          "max": 100,
          "tipKey": "etr_anteile"
        },
        {
          "key": "etr2_anteil_kwk",
          "label": "Anteil KWK (%)",
          "type": "number",
          "full": true,
          "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
          "required": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
          "min": 0,
          "max": 100,
          "tipKey": "etr_anteile"
        }
      ]
    },
    {
      "title": "Kuehlung",
      "fields": [
        { "key": "klimatisiert", "label": "Gibt es eine Kühlung im Gebäude?", "type": "radio", "required": true, "optionsRef": "ja_nein_radio" },
        { "key": "fernKuehlung", "label": "Erfolgt Kuehlung ueber Fernkaelte?", "type": "radio", "required": { "eq": ["klimatisiert", "Ja"] }, "when": { "eq": ["klimatisiert", "Ja"] }, "optionsRef": "ja_nein_radio" },
        { "key": "passiveKuehlung", "label": "Gibt es passive Kuehlung?", "type": "radio", "required": { "eq": ["klimatisiert", "Ja"] }, "when": { "eq": ["klimatisiert", "Ja"] }, "optionsRef": "ja_nein_radio" },
        { "key": "waermeKuehlung", "label": "Gibt es thermische Kuehlung?", "type": "radio", "required": { "eq": ["klimatisiert", "Ja"] }, "when": { "eq": ["klimatisiert", "Ja"] }, "optionsRef": "ja_nein_radio" },
        { "key": "stromKuehlung", "label": "Gibt es elektrische Kompressionskuehlung?", "type": "radio", "required": { "eq": ["klimatisiert", "Ja"] }, "when": { "eq": ["klimatisiert", "Ja"] }, "optionsRef": "ja_nein_radio" },
        { "key": "kuehlWfl", "label": "Gekuehlte Flaeche (m2)", "type": "number", "required": { "eq": ["klimatisiert", "Ja"] }, "when": { "eq": ["klimatisiert", "Ja"] }, "min": 1, "max": 500000, "hint": "z. B. 120" }
      ]
    }
  ]
}
