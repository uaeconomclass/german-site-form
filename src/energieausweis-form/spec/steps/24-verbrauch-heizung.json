{
  "id": "verbrauch_heizung",
  "title": "Verbrauchsdaten Heizung",
  "meta": "6",
  "when": { "eq": ["ausweisart", "Verbrauchsausweis"] },
  "intro": {
    "title": "Heizung (Verbrauch)",
    "text": "Erfassen Sie die Abrechnungszeiträume und Verbräuche laut Unterlagen. Sie können bis zu 3 Zeiträume je Energieträger angeben."
  },
  "fields": [
    {
      "type": "checklist",
      "full": true,
      "title": "Hauptenergieträger",
      "text": "Nutzen Sie die Einheit direkt aus der Abrechnung (z. B. kWh, m3, l)."
    },
    {
      "key": "etr1_kategorie",
      "label": "Energieträger",
      "type": "select",
      "full": true,
      "required": true,
      "optionsRef": "etr_kategorie_bk",
      "tipKey": "etr_kategorie"
    },
    {
      "key": "etr1_heizung",
      "label": "Für Heizung genutzt?",
      "type": "radio",
      "full": true,
      "required": true,
      "optionsRef": "ja_nein_radio"
    },
    {
      "key": "etr1_tww",
      "label": "Für Warmwasser genutzt?",
      "type": "radio",
      "full": true,
      "required": true,
      "optionsRef": "ja_nein_radio"
    },
    {
      "key": "etr1_periods",
      "label": "Abrechnungszeiträume",
      "type": "repeater",
      "full": true,
      "required": true,
      "itemLabel": "Zeitraum",
      "maxItems": 3,
      "tipKey": "etr_perioden",
      "fields": [
        { "key": "von", "label": "Von (TT.MM.JJJJ)", "type": "text", "required": true, "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$", "hint": "z. B. 01.08.2022" },
        { "key": "bis", "label": "Bis (TT.MM.JJJJ)", "type": "text", "required": true, "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$", "hint": "z. B. 31.07.2023" },
        { "key": "menge", "label": "Verbrauch gesamt (Einheit laut Abrechnung)", "type": "number", "required": true, "min": 0.001, "max": 999999999, "hint": "z. B. 12000 (kWh) oder 1300 (m3)" },
        { "key": "menge_tww", "label": "Davon Warmwasser (optional)", "type": "number", "required": false, "min": 0, "max": 999999999 },
        { "key": "leerstand_pct", "label": "Leerstand (%)", "type": "number", "required": true, "min": 0, "max": 100 }
      ]
    },
    {
      "key": "etr1_is_fw",
      "label": "Fernwärme?",
      "type": "radio",
      "full": true,
      "when": { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] },
      "required": { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] },
      "optionsRef": "ja_nein_radio",
      "tipKey": "etr_fw_flags"
    },
    {
      "key": "etr1_gebaeude_nah",
      "label": "Gebäudenah erzeugt?",
      "type": "radio",
      "full": true,
      "when": { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] },
      "required": { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] },
      "optionsRef": "ja_nein_radio",
      "tipKey": "etr_fw_flags"
    },
    {
      "key": "etr1_primfaktor",
      "label": "Primärenergiefaktor",
      "type": "number",
      "full": true,
      "when": { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] },
      "required": { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] },
      "min": 0,
      "max": 10,
      "tipKey": "etr_primfaktor"
    },
    {
      "key": "etr1_anteil_erneuerbar",
      "label": "Anteil erneuerbar (%)",
      "type": "number",
      "full": true,
      "when": { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] },
      "required": { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] },
      "min": 0,
      "max": 100,
      "tipKey": "etr_anteile"
    },
    {
      "key": "etr1_anteil_kwk",
      "label": "Anteil KWK (%)",
      "type": "number",
      "full": true,
      "when": { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] },
      "required": { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] },
      "min": 0,
      "max": 100,
      "tipKey": "etr_anteile"
    },
    {
      "type": "checklist",
      "full": true,
      "title": "Optional: zweiter Energieträger",
      "text": "Nur hinzufügen, wenn ein zusätzlicher Energieträger tatsächlich im Verbrauch vorkommt."
    },
    {
      "key": "etr2_enabled",
      "label": "Zweiten Energieträger erfassen",
      "type": "checkbox",
      "full": true,
      "tipKey": "etr2_optional"
    },
    {
      "key": "etr2_kategorie",
      "label": "Energieträger 2",
      "type": "select",
      "full": true,
      "when": { "eq": ["etr2_enabled", true] },
      "required": { "eq": ["etr2_enabled", true] },
      "optionsRef": "etr_kategorie_bk",
      "tipKey": "etr_kategorie"
    },
    {
      "key": "etr2_heizung",
      "label": "Für Heizung genutzt?",
      "type": "radio",
      "full": true,
      "when": { "eq": ["etr2_enabled", true] },
      "required": { "eq": ["etr2_enabled", true] },
      "optionsRef": "ja_nein_radio"
    },
    {
      "key": "etr2_tww",
      "label": "Für Warmwasser genutzt?",
      "type": "radio",
      "full": true,
      "when": { "eq": ["etr2_enabled", true] },
      "required": { "eq": ["etr2_enabled", true] },
      "optionsRef": "ja_nein_radio"
    },
    {
      "key": "etr2_periods",
      "label": "Abrechnungszeiträume (Energieträger 2)",
      "type": "repeater",
      "full": true,
      "when": { "eq": ["etr2_enabled", true] },
      "required": { "eq": ["etr2_enabled", true] },
      "itemLabel": "Zeitraum",
      "maxItems": 3,
      "tipKey": "etr_perioden",
      "fields": [
        { "key": "von", "label": "Von (TT.MM.JJJJ)", "type": "text", "required": true, "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$", "hint": "z. B. 01.08.2022" },
        { "key": "bis", "label": "Bis (TT.MM.JJJJ)", "type": "text", "required": true, "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$", "hint": "z. B. 31.07.2023" },
        { "key": "menge", "label": "Verbrauch gesamt (Einheit laut Abrechnung)", "type": "number", "required": true, "min": 0.001, "max": 999999999, "hint": "z. B. 12000 (kWh) oder 1300 (m3)" },
        { "key": "menge_tww", "label": "Davon Warmwasser (optional)", "type": "number", "required": false, "min": 0, "max": 999999999 },
        { "key": "leerstand_pct", "label": "Leerstand (%)", "type": "number", "required": true, "min": 0, "max": 100 }
      ]
    },
    {
      "key": "etr2_is_fw",
      "label": "Fernwärme?",
      "type": "radio",
      "full": true,
      "when": { "and": [{ "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
      "required": { "and": [{ "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
      "optionsRef": "ja_nein_radio",
      "tipKey": "etr_fw_flags"
    },
    {
      "key": "etr2_gebaeude_nah",
      "label": "Gebäudenah erzeugt?",
      "type": "radio",
      "full": true,
      "when": { "and": [{ "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
      "required": { "and": [{ "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
      "optionsRef": "ja_nein_radio",
      "tipKey": "etr_fw_flags"
    },
    {
      "key": "etr2_primfaktor",
      "label": "Primärenergiefaktor",
      "type": "number",
      "full": true,
      "when": { "and": [{ "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
      "required": { "and": [{ "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
      "min": 0,
      "max": 10,
      "tipKey": "etr_primfaktor"
    },
    {
      "key": "etr2_anteil_erneuerbar",
      "label": "Anteil erneuerbar (%)",
      "type": "number",
      "full": true,
      "when": { "and": [{ "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
      "required": { "and": [{ "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
      "min": 0,
      "max": 100,
      "tipKey": "etr_anteile"
    },
    {
      "key": "etr2_anteil_kwk",
      "label": "Anteil KWK (%)",
      "type": "number",
      "full": true,
      "when": { "and": [{ "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
      "required": { "and": [{ "eq": ["etr2_enabled", true] }, { "or": [{ "eq": ["etr2_kategorie", "BK_FW0"] }, { "eq": ["etr2_kategorie", "BK_FW70"] }] }] },
      "min": 0,
      "max": 100,
      "tipKey": "etr_anteile"
    }
  ]
}
