            { "img": "../assets/images/aussenwand/vollziegel.png", "label": "Vollziegel / Naturstein" },
            { "img": "../assets/images/aussenwand/hohlblockstein-bims.png", "label": "Hohlblock / Bims" },
            { "img": "../assets/images/aussenwand/ziegel-hochlochziegel.png", "label": "Ziegel" },
            { "img": "../assets/images/aussenwand/porenbeton-gasbeton.png", "label": "Porenbeton / Gasbeton" },
            { "img": "../assets/images/aussenwand/stahlbeton.png", "label": "Stahlbeton" },
