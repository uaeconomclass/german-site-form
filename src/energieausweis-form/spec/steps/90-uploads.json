{
  "id": "uploads",
  "title": "Uploadbereich",
  "meta": "6",
  "intro": { "title": "Uploadbereich", "text": "Bitte laden Sie die benötigten Unterlagen hoch." },
  "fields": [
    {
      "key": "upload_verbrauch_heizkosten",
      "label": "Heizkostenabrechnungen (letzte 3 Jahre)",
      "type": "file",
      "full": true,
      "when": { "eq": ["ausweisart", "Verbrauchsausweis"] },
      "required": { "eq": ["ausweisart", "Verbrauchsausweis"] },
      "accept": ".pdf,.jpg,.jpeg,.png",
      "multiple": true,
      "tipKey": "upload_verbrauch_heizkosten"
    },
    {
      "key": "upload_verbrauch_verbrauchsdaten",
      "label": "Verbrauchsdaten",
      "type": "file",
      "full": true,
      "when": { "eq": ["ausweisart", "Verbrauchsausweis"] },
      "required": { "eq": ["ausweisart", "Verbrauchsausweis"] },
      "accept": ".pdf,.jpg,.jpeg,.png",
      "multiple": true,
      "tipKey": "upload_verbrauch_verbrauchsdaten"
    },
    {
      "type": "checklist",
      "full": true,
      "when": { "eq": ["ausweisart", "Verbrauchsausweis"] },
      "title": "Verbrauchsausweis – Verbrauchsperioden (Energieträger)",
      "text": "Bitte erfassen Sie die Verbrauchsdaten strukturiert für den Hauptenergieträger. Einen zweiten Energieträger nur dann ausfüllen, wenn er tatsächlich vorhanden ist."
    },
    {
      "key": "etr1_kategorie",
      "label": "Energieträger 1 – Energieträgerkategorie",
      "type": "select",
      "full": true,
      "when": { "eq": ["ausweisart", "Verbrauchsausweis"] },
      "required": { "eq": ["ausweisart", "Verbrauchsausweis"] },
      "optionsRef": "etr_kategorie_bk",
      "tipKey": "etr_kategorie"
    },
    {
      "key": "etr1_heizung",
      "label": "Energieträger 1 wird für Heizung verwendet",
      "type": "radio",
      "full": true,
      "when": { "eq": ["ausweisart", "Verbrauchsausweis"] },
      "required": { "eq": ["ausweisart", "Verbrauchsausweis"] },
      "optionsRef": "ja_nein_radio"
    },
    {
      "key": "etr1_tww",
      "label": "Energieträger 1 wird für Warmwasser verwendet",
      "type": "radio",
      "full": true,
      "when": { "eq": ["ausweisart", "Verbrauchsausweis"] },
      "required": { "eq": ["ausweisart", "Verbrauchsausweis"] },
      "optionsRef": "ja_nein_radio"
    },
    {
      "key": "etr1_is_fw",
      "label": "Energieträger 1 ist Fernwärme",
      "type": "radio",
      "full": true,
      "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
      "required": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
      "optionsRef": "ja_nein_radio",
      "tipKey": "etr_fw_flags"
    },
    {
      "key": "etr1_gebaeude_nah",
      "label": "Energieträger 1 gebäudenah erzeugt",
      "type": "radio",
      "full": true,
      "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
      "required": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
      "optionsRef": "ja_nein_radio",
      "tipKey": "etr_fw_flags"
    },
    {
      "key": "etr1_primfaktor",
      "label": "Primärenergiefaktor (Energieträger 1)",
      "type": "number",
      "full": true,
      "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
      "required": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
      "min": 0,
      "max": 10,
      "tipKey": "etr_primfaktor"
    },
    {
      "key": "etr1_anteil_erneuerbar",
      "label": "Anteil erneuerbar (%) – Energieträger 1",
      "type": "number",
      "full": true,
      "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
      "required": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
      "min": 0,
      "max": 100,
      "tipKey": "etr_anteile"
    },
    {
      "key": "etr1_anteil_kwk",
      "label": "Anteil KWK (%) – Energieträger 1",
      "type": "number",
      "full": true,
      "when": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
      "required": { "and": [{ "eq": ["ausweisart", "Verbrauchsausweis"] }, { "or": [{ "eq": ["etr1_kategorie", "BK_FW0"] }, { "eq": ["etr1_kategorie", "BK_FW70"] }] }] },
      "min": 0,
      "max": 100,
      "tipKey": "etr_anteile"
    },
    {
      "key": "etr1_periods",
      "label": "Energieträger 1 – Abrechnungszeiträume",
      "type": "repeater",
      "full": true,
      "when": { "eq": ["ausweisart", "Verbrauchsausweis"] },
      "required": { "eq": ["ausweisart", "Verbrauchsausweis"] },
      "itemLabel": "Zeitraum",
      "maxItems": 3,
      "tipKey": "etr_perioden",
      "fields": [
        { "key": "von", "label": "Von (TT.MM.JJJJ)", "type": "text", "required": true, "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$", "hint": "z. B. 01.01.2021" },
        { "key": "bis", "label": "Bis (TT.MM.JJJJ)", "type": "text", "required": true, "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$", "hint": "z. B. 31.12.2021" },
        { "key": "menge", "label": "Gesamtmenge", "type": "number", "required": true, "min": 0.001, "max": 999999999 },
        { "key": "menge_tww", "label": "Menge TWW (optional)", "type": "number", "required": false, "min": 0, "max": 999999999 },
        { "key": "leerstand_pct", "label": "Leerstand (%)", "type": "number", "required": true, "min": 0, "max": 100 }
      ]
    },
    {
      "key": "etr2_enabled",
      "label": "Zweiten Energieträger erfassen (optional)",
      "type": "checkbox",
      "full": true,
      "when": { "eq": ["ausweisart", "Verbrauchsausweis"] },
      "tipKey": "etr2_optional"
    },
